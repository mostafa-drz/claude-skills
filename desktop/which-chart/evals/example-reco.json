 "options": [
  {
   "id": "diverging-bars",
   "rank": "pick",
   "name": "Diverging stacked columns by week",
   "answers": "Is it getting better or worse, and when did it turn?",
   "why": [
    {
     "text": "Built for ordered scales like negative–neutral–positive: neutral straddles zero in grey, positive stacks up and negative down, so a week's balance is how far it reaches above versus below the line.",
     "cites": [
      1,
      8
     ]
    },
    {
     "text": "One column per week on a shared axis: a spike in negative shows at a glance as a longer red column below the line.",
     "cites": [
      1
     ]
    },
    {
     "text": "Bar lengths on a common axis are judged far more accurately than the angles of a pie per week.",
     "cites": [
      3,
      1
     ]
    }
   ],
   "costs": [
    "Shows shares, not volume: a quiet week and a viral week look the same size.",
    "Needs a small transform to centre neutral (included in the spec)."
   ],
   "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "data": {
     "name": "table"
    },
    "height": 240,
    "transform": [
     {
      "joinaggregate": [
       {
        "op": "sum",
        "field": "mentions",
        "as": "total"
       }
      ],
      "groupby": [
       "week"
      ]
     },
     {
      "calculate": "datum.mentions / datum.total",
      "as": "share"
     },
     {
      "calculate": "datum.sentiment === 'Negative' ? 1 : datum.sentiment === 'Neutral' ? 2 : 3",
      "as": "order"
     },
     {
      "calculate": "datum.sentiment === 'Negative' ? datum.share : datum.sentiment === 'Neutral' ? datum.share / 2 : 0",
      "as": "below"
     },
     {
      "stack": "share",
      "groupby": [
       "week"
      ],
      "sort": [
       {
        "field": "order"
       }
      ],
      "as": [
       "s0",
       "s1"
      ]
     },
     {
      "joinaggregate": [
       {
        "op": "sum",
        "field": "below",
        "as": "offset"
       }
      ],
      "groupby": [
       "week"
      ]
     },
     {
      "calculate": "datum.s0 - datum.offset",
      "as": "y0"
     },
     {
      "calculate": "datum.s1 - datum.offset",
      "as": "y1"
     }
    ],
    "layer": [
     {
      "mark": {
       "type": "bar",
       "stroke": "#fcfcfb",
       "strokeWidth": 2
      },
      "encoding": {
       "x": {
        "field": "week",
        "type": "ordinal",
        "timeUnit": "utcyearmonthdate",
        "title": null,
        "axis": {
         "format": "%b %d",
         "labelAngle": 0
        }
       },
       "y": {
        "field": "y0",
        "type": "quantitative",
        "title": "Share of mentions (negative below, positive above)",
        "axis": {
         "format": ".0%"
        }
       },
       "y2": {
        "field": "y1"
       },
       "color": {
        "field": "sentiment",
        "type": "nominal",
        "title": null,
        "scale": {
         "domain": [
          "Negative",
          "Neutral",
          "Positive"
         ],
         "range": [
          "#e34948",
          "#bdbcb5",
          "#2a78d6"
         ]
        },
        "legend": {
         "orient": "top"
        }
       },
       "order": {
        "field": "order"
       },
       "tooltip": [
        {
         "field": "week",
         "type": "temporal",
         "format": "%b %d, %Y",
         "formatType": "utc"
        },
        {
         "field": "sentiment"
        },
        {
         "field": "share",
         "format": ".0%"
        },
        {
         "field": "mentions",
         "format": ","
        }
       ]
      }
     },
     {
      "mark": {
       "type": "rule",
       "strokeWidth": 1
      },
      "encoding": {
       "y": {
        "datum": 0
       },
       "color": {
        "value": "#898781"
       }
      }
     }
    ]
   }
  },
  {
   "id": "total-and-shares",
   "rank": "alternative",
   "name": "Total mentions over share lines",
   "answers": "How loud was it, and how did the mix move?",
   "choose_if": "volume matters as much as mood, for example to tell a crisis from a quiet week.",
   "why": [
    {
     "text": "Few's recommended form for time series plus part-to-whole: a line of the total aligned above lines of the parts.",
     "cites": [
      2
     ]
    },
    {
     "text": "Each sentiment is its own line on a common baseline, so all three trends are readable, not just the bottom one.",
     "cites": [
      2,
      3
     ]
    }
   ],
   "costs": [
    "Two panels need more height than a single tile.",
    "Lines of share don't show that the three always add to 100%."
   ],
   "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "data": {
     "name": "table"
    },
    "vconcat": [
     {
      "height": 90,
      "title": "Total mentions",
      "mark": {
       "type": "line",
       "strokeWidth": 2,
       "color": "#52514e"
      },
      "encoding": {
       "x": {
        "field": "week",
        "type": "temporal",
        "title": null,
        "axis": {
         "format": "%b %d",
         "labels": false,
         "formatType": "utc"
        },
        "scale": {
         "type": "utc"
        }
       },
       "y": {
        "aggregate": "sum",
        "field": "mentions",
        "type": "quantitative",
        "title": null,
        "axis": {
         "format": "~s",
         "tickCount": 3
        }
       },
       "tooltip": [
        {
         "field": "week",
         "type": "temporal",
         "format": "%b %d",
         "formatType": "utc"
        },
        {
         "aggregate": "sum",
         "field": "mentions",
         "title": "mentions",
         "format": ","
        }
       ]
      }
     },
     {
      "height": 150,
      "title": "Share by sentiment",
      "transform": [
       {
        "joinaggregate": [
         {
          "op": "sum",
          "field": "mentions",
          "as": "total"
         }
        ],
        "groupby": [
         "week"
        ]
       },
       {
        "calculate": "datum.mentions / datum.total",
        "as": "share"
       }
      ],
      "mark": {
       "type": "line",
       "strokeWidth": 2,
       "point": {
        "size": 30
       }
      },
      "encoding": {
       "x": {
        "field": "week",
        "type": "temporal",
        "title": null,
        "axis": {
         "format": "%b %d",
         "formatType": "utc"
        },
        "scale": {
         "type": "utc"
        }
       },
       "y": {
        "field": "share",
        "type": "quantitative",
        "title": null,
        "axis": {
         "format": ".0%"
        }
       },
       "color": {
        "field": "sentiment",
        "type": "nominal",
        "title": null,
        "scale": {
         "domain": [
          "Negative",
          "Neutral",
          "Positive"
         ],
         "range": [
          "#e34948",
          "#bdbcb5",
          "#2a78d6"
         ]
        },
        "legend": {
         "orient": "top"
        }
       },
       "tooltip": [
        {
         "field": "week",
         "type": "temporal",
         "format": "%b %d",
         "formatType": "utc"
        },
        {
         "field": "sentiment"
        },
        {
         "field": "share",
         "format": ".0%"
        }
       ]
      }
     }
    ],
    "resolve": {
     "scale": {
      "x": "shared"
     }
    }
   }
  },
  {
   "id": "net-sentiment",
   "rank": "alternative",
   "name": "Net sentiment line",
   "answers": "Is the balance positive or negative right now?",
   "choose_if": "the panel is a small tile or a KPI row and one trend line is all that fits.",
   "why": [
    {
     "text": "A deviation chart: one line against a fixed zero reference, the simplest read of 'better or worse'.",
     "cites": [
      4
     ]
    }
   ],
   "costs": [
    "Hides neutral and volume entirely.",
    "A net score is a team convention, not a standard; define it on the dashboard."
   ],
   "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "data": {
     "name": "table"
    },
    "height": 200,
    "transform": [
     {
      "calculate": "datum.sentiment === 'Positive' ? datum.mentions : datum.sentiment === 'Negative' ? -datum.mentions : 0",
      "as": "signed"
     },
     {
      "aggregate": [
       {
        "op": "sum",
        "field": "signed",
        "as": "net_count"
       },
       {
        "op": "sum",
        "field": "mentions",
        "as": "total"
       }
      ],
      "groupby": [
       "week"
      ]
     },
     {
      "calculate": "datum.net_count / datum.total",
      "as": "net"
     }
    ],
    "layer": [
     {
      "mark": {
       "type": "rule",
       "strokeWidth": 1
      },
      "encoding": {
       "y": {
        "datum": 0
       },
       "color": {
        "value": "#898781"
       }
      }
     },
     {
      "mark": {
       "type": "line",
       "strokeWidth": 2,
       "color": "#2a78d6",
       "point": {
        "size": 30,
        "color": "#2a78d6"
       }
      },
      "encoding": {
       "x": {
        "field": "week",
        "type": "temporal",
        "title": null,
        "axis": {
         "format": "%b %d",
         "formatType": "utc"
        },
        "scale": {
         "type": "utc"
        }
       },
       "y": {
        "field": "net",
        "type": "quantitative",
        "title": "Net sentiment (positive − negative share)",
        "axis": {
         "format": "+.0%"
        }
       },
       "tooltip": [
        {
         "field": "week",
         "type": "temporal",
         "format": "%b %d",
         "formatType": "utc"
        },
        {
         "field": "net",
         "format": "+.0%",
         "title": "net"
        },
        {
         "field": "total",
         "format": ",",
         "title": "mentions"
        }
       ]
      }
     }
    ]
   }
  }
 ],
 "avoid": [
  {
   "name": "A pie or donut per week",
   "why": "angles across separate circles can't be compared; the series fails at the one job, change over time.",
   "cites": [
    2,
    1
   ]
  },
  {
   "name": "Volume bars plus sentiment line on two y-axes",
   "why": "the alignment of the two scales is arbitrary and invents correlations.",
   "cites": [
    5
   ]
  },
  {
   "name": "Red vs green for negative vs positive",
   "why": "the most common colour-vision deficiency can't separate them; use blue vs red with grey neutral, plus a legend.",
   "cites": [
    6,
    7
   ]
  }
 ],
 "screenshots": [],
 "build_notes": [
  "Colours: Positive #2a78d6, Neutral #bdbcb5, Negative #e34948 (dark mode #3987e5, #57564f, #e66767). Checked for colour-vision separation.",
  "Keep the legend and the table view: neutral grey is deliberately low-contrast, so it needs a second way to be read.",
  "Order the stack Negative → Neutral → Positive, never alphabetical.",
  "Porting to Recharts: stacked BarChart with stackOffset=\"sign\"; negative as a negative value, neutral split into two half-series either side of zero."
 ],
